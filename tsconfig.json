{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "types": ["vitest/globals"]
  },
  "include": ["src", "scripts", "api", "tests", ".astro/types.d.ts"],
  "exclude": ["dist", "node_modules"]
}
