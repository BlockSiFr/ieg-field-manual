---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Accessibility" description="IEG Field Manual Accessibility">
  <section class="section">
    <div class="container prose-measure">
      <p class="eyebrow">Legal</p>
      <h1 class="section-title">Accessibility</h1>
      <p style="color:var(--dastor-text-muted)">IEG Field Manual targets WCAG 2.2 AA. Automated checks are not a claim of full compliance. Report issues to accessibility@blocksifr.com (placeholder).</p>
      <p class="meta">Marked for legal review in the implementation report.</p>
    </div>
  </section>
</BaseLayout>
