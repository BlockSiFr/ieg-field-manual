---
import BaseLayout from "@/layouts/BaseLayout.astro";

const sequence = [
  { step: "01", title: "Trace", description: "Start with a failure, action, or decision. Follow the causal path to reachable people, data, systems, money, and physical resources." },
  { step: "02", title: "Assess", description: "Estimate exposure, recoverable value, likelihood, and practical constraints. Keep an impact hypothesis separate from observed damage or savings." },
  { step: "03", title: "Bound", description: "Define acceptable outcomes and irreversible boundaries. Identity and Execution Governance determines what is authorized to happen." },
  { step: "04", title: "Verify", description: "Test the causal hypothesis where authorized, record what occurred, and distinguish modeled, observed, and independently confirmed evidence." },
];
const outcomes = [
  { title: "Security investment", text: "Prioritize weaknesses by credible business damage rather than vulnerability counts or severity labels alone." },
  { title: "Autonomous operations", text: "Connect permissions and agent behavior to what could change, who could be harmed, and how an action can be stopped or reversed." },
  { title: "Compute, energy, and cooling", text: "Evaluate whether capacity recovery or workload changes create real value under quality, thermal, power, and safety constraints." },
  { title: "Executive accountability", text: "Explain the consequence, the basis for the decision, the evidence obtained, and the uncertainties that remain." },
];
---
<BaseLayout
  title="Consequence Intelligence | BlockSiFr"
  description="Consequence Intelligence connects vulnerabilities, autonomous actions, and infrastructure decisions to business impact, admissible outcomes, and evidence."
  canonicalPath="/consequence-intelligence"
>
  <section class="section grid-bg ci-hero" aria-labelledby="ci-title">
    <div class="container">
      <p class="eyebrow">BlockSiFr / Category Thesis</p>
      <h1 id="ci-title" class="display">CONSEQUENCE<br/><span class="gold-text">INTELLIGENCE.</span></h1>
      <p class="ci-lead">Stop counting problems. Start explaining what those problems can cause.</p>
      <p class="ci-intro">Organizations invest in security, automation, and infrastructure yet struggle to explain what damage that spending prevents or what value those systems actually create. A vulnerability rating does not establish loss. An access grant does not establish authority to cause every outcome. A compute metric does not establish savings.</p><p class="ci-intro"><strong>Consequence Intelligence starts with the outcome, works backward through credible causal paths, and makes uncertainty visible.</strong></p>
      <div class="ci-actions">
        <a class="btn btn-primary" href="/brief">Build a free consequence brief</a>\n        <a class="btn btn-ghost" href="/toolkit">Get the practical toolkit</a>
      </div>
      <p class="ci-note">Category framework published by BlockSiFr. The wider concepts of consequence-based security and operational risk have established prior art.</p>
    </div>
  </section>
  <section class="section" aria-labelledby="apply-title">
    <div class="container">
      <p class="eyebrow">Apply the method</p>
      <h2 id="apply-title" class="section-title">Four questions worth sharing with your team</h2>
      <div class="ci-grid">
        <article class="ci-card"><h3>What damage does security spending prevent?</h3><p>Go beyond a severity score to a plausible business effect.</p><a href="/consequences/security-spend">Explore the security case</a></article>
        <article class="ci-card"><h3>What can an AI agent actually cause?</h3><p>Examine the action boundary, not only the credential.</p><a href="/consequences/ai-agents">Explore the AI case</a></article>
        <article class="ci-card"><h3>What value does compute efficiency really create?</h3><p>Distinguish a workload reduction from measured facility savings.</p><a href="/consequences/data-center">Explore the data-center case</a></article>
        <article class="ci-card"><h3>What could this release change?</h3><p>Connect code diffs to operations, rollback, and proof.</p><a href="/consequences/software-change">Explore the software case</a></article>
      </div>
    </div>
  </section>
  <section class="section paper-panel" aria-labelledby="definition-title">
    <div class="container">
      <p class="eyebrow" style="color:#61503a">01 / Definition</p>
      <h2 id="definition-title" class="section-title" style="color:#111315">What could happen? What would it matter? How do we know?</h2>
      <p class="ci-definition">Consequence Intelligence is the discipline of connecting a possible event or action to its reachable consequences, business significance, admissible boundaries, and observable results.</p>
      <p class="ci-paper">It spans cybersecurity, identity, AI operations, software change, energy, cooling, and critical infrastructure. The objective is not a fabricated dollar figure or zero-risk promise. It is a defensible decision grounded in causal analysis, measurement, constraints, and evidence.</p>
    </div>
  </section>
  <section class="section" aria-labelledby="method-title">
    <div class="container">
      <p class="eyebrow">02 / Operating Method</p>
      <h2 id="method-title" class="section-title">Follow the consequence. Do not stop at the finding.</h2>
      <div class="ci-grid">
        {sequence.map((item) => (
          <article class="ci-card">
            <span class="meta">{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section paper-panel" aria-labelledby="outcomes-title">
    <div class="container">
      <p class="eyebrow" style="color:#61503a">03 / Customer Outcomes</p>
      <h2 id="outcomes-title" class="section-title" style="color:#111315">Different sectors. The same missing answer.</h2>
      <div class="ci-grid">
        {outcomes.map((item) => (
          <article class="ci-card ci-card-light">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="proof-title">
    <div class="container">
      <p class="eyebrow">04 / Evidence Discipline</p>
      <h2 id="proof-title" class="section-title">Possible, observed, and proven are different things.</h2>
      <p class="ci-intro">Every material consequence claim needs a causal path, scope, assumptions, relevant baseline, affected outcome, and evidence classification. A modeled loss is not an observed incident. A vulnerability hypothesis is not a confirmed exploit. Simulated energy savings are not measured facility savings. Self-attestation is not independent verification.</p>
      <div class="ci-actions">
        <a class="btn btn-primary" href="https://www.blocksifr.com/">Review Current Evidence</a>
        <a class="btn btn-ghost" href="/assessment">Assess Execution Governance</a>
      </div>
    </div>
  </section>
  <section class="section paper-panel" aria-labelledby="discipline-title">
    <div class="container">
      <p class="eyebrow" style="color:#61503a">05 / Open Doctrine and Commercial Platform</p>
      <h2 id="discipline-title" class="section-title" style="color:#111315">Consequence Intelligence is the category. IEG is the governance discipline.</h2>
      <p class="ci-paper">Identity and Execution Governance (IEG) explains how identity, authority, and protected actions bound consequences in autonomous systems. This public IEG Field Manual provides practitioner guidance, not a product dashboard. BlockSiFr Control is the commercial point of entry; BLAKE/CFAV, CortexTrace, IFC, and TAVAN address distinct consequence-discovery, evidence, compute, and infrastructure questions.</p>
      <p class="ci-paper">These roles describe a strategic architecture, not a claim that every component is production-integrated or independently validated.</p>
      <div class="ci-actions">
        <a class="btn btn-ink" href="https://app.blocksifr.com/">Explore BlockSiFr Control</a>
        <a class="btn btn-ink" href="/manual">Open the IEG Field Manual</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .ci-hero { padding-block:clamp(5rem,10vw,9rem); }
  .ci-hero h1 { font-size:clamp(2.8rem,9vw,7.2rem); line-height:.98; margin:.75rem 0 1.75rem; overflow-wrap:break-word; }
  .ci-lead { max-width:22ch; font-family:var(--font-display); font-size:clamp(1.5rem,3vw,2.5rem); line-height:1.22; margin:0 0 1.5rem; }
  .ci-intro { max-width:70ch; color:var(--blocksifr-text-muted); line-height:1.7; }
  .ci-actions { display:flex; flex-wrap:wrap; gap:.75rem; margin-top:2rem; }
  .ci-note { margin-top:2rem; max-width:75ch; font-family:var(--font-mono); color:var(--blocksifr-text-muted); font-size:.7rem; line-height:1.65; }
  .ci-definition { max-width:54ch; font-family:var(--font-display); font-size:clamp(1.25rem,2.6vw,2rem); line-height:1.4; color:#171716; }
  .ci-paper { color:#35332f; max-width:72ch; }
  .ci-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; margin-top:2rem; }
  .ci-card { border:1px solid rgba(216,182,106,.22); padding:clamp(1.25rem,3vw,2rem); background:rgba(255,255,255,.02); }
  .ci-card h3 { font-family:var(--font-display); font-size:1.4rem; margin:.8rem 0 .5rem; }
  .ci-card p { color:var(--blocksifr-text-muted); margin:0 0 1rem; }\n  .ci-card a { color:var(--blocksifr-gold-light);font-family:var(--font-display);font-weight:600;font-size:.9rem;text-underline-offset:4px; }
  .ci-card-light { border-color:rgba(9,10,11,.15); background:rgba(255,255,255,.34); }
  .ci-card-light h3 { color:#111315; }
  .ci-card-light p { color:#35332f; }
  @media (max-width:640px) { .ci-grid { grid-template-columns:1fr; } }
</style>
