---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="display footer-brand">IEG Field Manual</p>
      <p class="footer-copy">
        The Identity and Execution Governance Field Manual. Published openly by BlockSiFr LLC.
        Govern what systems may cause.
      </p>
    </div>
    <div>
      <p class="eyebrow">Publication</p>
      <ul>
        <li><a href="/manual">Manual</a></li>
        <li><a href="/chapters">Chapters</a></li>
        <li><a href="/execution-stack">Execution Stack</a></li>
        <li><a href="/resources">Resources</a></li>
        <li><a href="/assessment">Assessment</a></li>
      </ul>
    </div>
    <div>
      <p class="eyebrow">BlockSiFr</p>
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/author">Author</a></li>
        <li><a href="https://github.com/BlockSiFr/ieg-field-manual" target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href="https://www.blocksifr.com">BlockSiFr</a></li>
      </ul>
    </div>
    <div>
      <p class="eyebrow">Legal</p>
      <ul>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/licensing">Licensing</a></li>
        <li><a href="/accessibility">Accessibility</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-base">
    <p class="meta">© {year} BlockSiFr LLC. Free doctrine. Open knowledge. Paid enforcement.</p>
    <p class="meta">ieg.blocksifr.com</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--dastor-line-light);
    padding-block: 3.5rem 2rem;
    background: var(--dastor-carbon);
  }
  .footer-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1.4fr repeat(3, 1fr);
  }
  .footer-brand {
    font-size: 1.65rem;
    margin: 0 0 0.75rem;
  }
  .footer-copy {
    max-width: 36ch;
    color: var(--dastor-text-muted);
    margin: 0;
    font-size: 0.95rem;
  }
  .site-footer ul {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }
  .site-footer li + li {
    margin-top: 0.45rem;
  }
  .site-footer a {
    text-decoration: none;
    color: var(--dastor-text-light);
  }
  .site-footer a:hover {
    color: var(--dastor-paper);
  }
  .footer-base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--dastor-line-light);
  }
  .meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dastor-text-muted);
  }
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-base {
      flex-direction: column;
    }
  }
</style>
